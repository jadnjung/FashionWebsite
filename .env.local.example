NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support email shown on /contact (mailto: link). Not a secret — safe to
# expose. Not yet provisioned (no business domain/email registered yet,
# see PROJECT.md §96/§101); until set, /contact shows an honest
