# Shopify Storefront API — not yet provisioned (no store exists yet).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=

# Klaviyo — not yet provisioned.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=

# Drop-specific early-access code for the upcoming-collection gate
# (app/(storefront)/collections/[handle]). Checked server-side only, via
# plain string equality against the submitted code — never exposed to
# Shopify or the client bundle. See PROJECT.md §16, DECISIONS.md's
# drop-gate entry. The whole-site password gate this replaced
# (ESQUE_ACCESS_PASSWORD/ESQUE_EARLY_ACCESS_PASSWORD) is gone — the site
# is fully public now.
ESQUE_DROP_ACCESS_CODE=

# Analytics — not yet provisioned.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console site-verification meta tag content — not yet
# provisioned (no real Search Console property exists yet). Not a secret:
# Google's own docs describe this token as meant to be embedded in public
# page source. See DECISIONS.md D-055.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support email shown on /contact (mailto: link). Not a secret — safe to
# expose. Not yet provisioned (no business domain/email registered yet,
# see PROJECT.md §96/§101); until set, /contact shows an honest
# "ESQUE PLACEHOLDER" state instead of a fabricated address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Demo Mode — opt-in, off by default everywhere (leave unset). When set to
# exactly '1', renders local stock photography (public/preview-demo/*.jpg)
# in place of real Shopify data and the sitewide "ESQUE PLACEHOLDER"
# markers, for stakeholder-preview convenience only — it is never a
# production fallback. Never set this in CI or in a real deployment. See
# DECISIONS.md D-057 and public/preview-demo/SOURCES.md.
PREVIEW_DEMO_MODE=
